# Скопируйте в .env и заполните нужное. .env не попадает в git.

# 2ГИС: ключ из https://platform.2gis.ru (раздел «API-ключи», есть демо-ключ)
DGIS_API_KEY=

# Claude API: нужен только для --llm (kwork) и --pitch (leads)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Telegram-уведомления о новых заказах (--telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Если Kwork начнёт отвечать 403 — cookie из браузера (DevTools → Network → заголовок Cookie)
KWORK_COOKIE=

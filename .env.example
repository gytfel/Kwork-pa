# Скопируйте в .env и заполните нужное. .env не попадает в git.

# 2ГИС: ключ из https://platform.2gis.ru (раздел «API-ключи», есть демо-ключ)
DGIS_API_KEY=

# Telegram-бот: токен от @BotFather. Чат запоминается сам, когда вы нажмёте «Старт».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Чем писать черновики: auto (по умолчанию), api, claude-code или templates
# KWORK_PA_AI=auto

# Claude API — не обязателен: без него черновики пишет Claude Code по подписке или шаблоны
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Модель для режима claude-code, например sonnet (экономит лимиты подписки)
# CLAUDE_CODE_MODEL=sonnet

# Если Kwork начнёт отвечать 403 — cookie из браузера (DevTools → Network → заголовок Cookie)
KWORK_COOKIE=
